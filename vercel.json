{
  "name": "dejan-coaching-hub",
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/datenschutz",
      "destination": "/de/datenschutz",
      "permanent": true
    },
    {
      "source": "/de/gulf",
      "destination": "/gulf",
      "permanent": true
    }
  ]
}
